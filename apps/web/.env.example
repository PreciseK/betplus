# Base URL of the Laravel API (apps/platform), including /v1. Must be prefixed
# NEXT_PUBLIC_ to be readable client-side — this is a static export, no server runtime.
# Production: https://api.betplus.com.ng/v1
# Local dev: http://localhost:8000/v1
NEXT_PUBLIC_API_BASE_URL=https://api.betplus.com.ng/v1
# Back-office API base URL (isolated from player /v1).
# Production: https://api.betplus.com.ng/backoffice/v1
# Local dev: http://localhost:8000/backoffice/v1
NEXT_PUBLIC_BACKOFFICE_API_BASE_URL=https://api.betplus.com.ng/backoffice/v1

# Cloudflare Turnstile Site Key (Public)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
