{
    "name": "betplus/engine-blackred",
    "description": "BlackRed instant fixed-odds prediction engine. Pure function of (seed, ticket_id, input). No database credentials, no external calls, no filesystem writes, no randomness. REQ-GEC-001..003.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Betplus\\EngineBlackred\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Betplus\\EngineBlackred\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --debug"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
