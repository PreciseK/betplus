APP_NAME=Betplus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# apps/web's origin(s), comma-separated. Static export — a separate origin from this API
# in both dev and production (config/cors.php).
CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking (sentry/sentry-laravel) — inert with this unset; nothing is sent
# anywhere. Create a project at sentry.io (or a self-hosted instance) and paste its DSN
# here to activate. See config/sentry.php for the rest of the (already-wired) config.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ponytail: database-backed cache/session/queue everywhere above is correct for local dev
# (no Redis server here) but the real production ceiling — every access-token check,
# rate-limit bucket, and queued job round-trips MySQL instead. Once a Redis instance is
# provisioned, switch to it with ONLY these four lines (no code changes — SessionService,
# InstitutionAuthService and RegistrationService already read through the Cache/RateLimiter
# facades, which follow CACHE_STORE):
#   CACHE_STORE=redis
#   SESSION_DRIVER=redis
#   QUEUE_CONNECTION=redis
#   REDIS_CLIENT=predis   (already the default below — predis is a pure-PHP client, so it
#                          works on hosts without the phpredis PECL extension, e.g. cPanel
#                          without root)
# Queued jobs (DispatchPrizePayoutJob, PollPayoutStatusJob, etc.)
# still need a persistent `queue:work` process either way — switching to redis alone
# doesn't supervise one. See infra/systemd/README.md.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPAY_BASE_URL=https://testapi.opaycheckout.com
OPAY_MERCHANT_ID=
OPAY_PAYOUT_PRIVATE_KEY=
# Comma-separated. Empty = unrestricted (dev only) — set from OPay's published callback
# source ranges before production (REQ-PAY-014).
OPAY_CALLBACK_IP_ALLOWLIST=
# Verifies the payout order-notification callback (OpayPayoutCallbackVerifier) — see
# its doc comment for the unconfirmed-scheme caveat.
OPAY_PAYOUT_CALLBACK_SECRET=
# Must be a publicly reachable URL before this goes near a real OPay sandbox.
OPAY_PAYOUT_NOTIFY_URL=

# Story 3.5 (Epic 3) — no real geolocation vendor is contracted; StubLocationSignalProvider
# returns this fixed state/confidence for every player.
GEO_MIN_CONFIDENCE=0.80
GEO_STUB_STATE_CODE=LAG
GEO_STUB_CONFIDENCE=0.95
JURISDICTION_RULESET_VERSION=2026.1

# Story 3.8 (Epic 3) — config-file tax ruleset until Epic 6's maker-checker DB-backed
# version exists (see config/tax.php's doc comment).
WHT_RULESET_VERSION=LAG-WHT-2026.1
WHT_BASIS=gross_prize
WHT_RESIDENT_RATE_BP=500
WHT_NON_RESIDENT_RATE_BP=1500
WHT_BASIS_LABEL="Gross prize"

# Story 3.9 (Epic 3) — platform default shown as "Daily limit" until Epic 5 ships
# player-settable RG limits.
GAME_DEFAULT_DAILY_LIMIT_KOBO=5000000

# Story 4.6/4.8 (Epic 4) — see config/payout.php's doc comment on the float thresholds
# being placeholders pending real Finance-provided payout volume.
PAYOUT_MANUAL_REVIEW_THRESHOLD_KOBO=100000000
PAYOUT_EXPECTED_DAILY_KOBO=500000000
PAYOUT_LARGEST_PRIZE_KOBO=52000000

# See config/funding.php's doc comment — deposits are credited off a trust check,
# not a verified inbound payment; this bounds the advance, pending Finance sign-off.
FUNDING_MANUAL_REVIEW_THRESHOLD_KOBO=5000000

# Identity vault (REQ-ID-023) — a separate schema and credential from DB_*, never the same
# database user. Leave VAULT_DB_* unset for local dev (defaults to its own sqlite file).
# In production set VAULT_DB_CONNECTION=mariadb plus VAULT_DB_HOST/DATABASE/USERNAME/PASSWORD
# for a restricted-grant user with no access to the main schema.
VAULT_DB_CONNECTION=sqlite
# 32-byte key, base64: `php artisan key:generate --show` produces a value in this shape.
VAULT_ENCRYPTION_KEY=

# Epic 6 — encrypts institution-user TOTP secrets, deliberately a different key from
# both APP_KEY and VAULT_ENCRYPTION_KEY (see MfaSecretCipher's doc comment).
BACKOFFICE_MFA_ENCRYPTION_KEY=

# Epic 7 — loopback to apps/engine-heritage (see that app's README for the run
# command). Defaults already match a local `uv run uvicorn` on the default port.
HERITAGE_ENGINE_BASE_URL=http://127.0.0.1:8100
HERITAGE_ENGINE_TIMEOUT_SECONDS=5
