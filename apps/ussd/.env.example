# Base URL of the platform API.
# Co-located / local: http://127.0.0.1:8000
# Production remote: https://betplus.com.ng
PLATFORM_BASE_URL=http://127.0.0.1:8000

# Shared secret between USSD gateway/aggregator (e.g. Africa's Talking) and this service
USSD_GATEWAY_SHARED_SECRET=

# Directory for caching session state (default: system temp dir / Redis in prod)
# USSD_SESSION_STORE_DIR=/tmp/betplus-ussd-sessions

PLATFORM_REQUEST_TIMEOUT_SECONDS=10
