{
    "name": "betplus/ussd",
    "description": "USSD channel adapter. Calls the platform API over HTTP for every money and game operation. Holds no money logic, no database access. REQ-QA-013, REQ-NOT-008.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Betplus\\Ussd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Betplus\\Ussd\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --debug"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
