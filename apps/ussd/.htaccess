# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # Route /notify to notification handler
    RewriteRule ^notify/?$ public/notification.php [L,QSA]

    # If request is already for public/ or an existing file/directory, don't rewrite
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Rewrite all requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
